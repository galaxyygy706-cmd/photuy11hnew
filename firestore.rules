rules_version = '2';

// MVP rules: any signed-in request can read/write. This is fine for an
// internal staff tool behind a login, but before going further you should
// add Firebase Authentication and tighten this (e.g. require a custom
// "staff" claim, or restrict writes to specific fields per collection).
service cloud.firestore {
  match /databases/{database}/documents {

    match /tables/{tableId} {
      allow read, write: if request.auth != null;
    }

    match /orders/{tableId} {
      allow read, write: if request.auth != null;
    }

    match /history/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // history is append-only
    }
  }
}
